{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "gen:api": "tsx scripts/gen-api.ts",
    "gen:api:smoke": "tsx scripts/gen-api-smoke.ts",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm test",
    "ci:fix": "pnpm run format:fix && pnpm run lint:fix && pnpm run build && pnpm test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=8",
    "npm": ">=999.0.0",
    "yarn": ">=999.0.0"
  },
  "dependencies": {
    "@angular/animations": "^21.1.0",
    "@angular/cdk": "~21.2.8",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "~21.2.8",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/service-worker": "^21.2.18",
    "bootstrap": "^5.3.8",
    "leaflet": "^1.9.4",
    "ngx-extended-pdf-viewer": "^27.0.0",
    "pdfmake": "^0.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/pwa": "^21.1.5",
    "@eslint/js": "^10.0.1",
    "@orval/angular": "^7.0.0",
    "@orval/core": "^8.25.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/leaflet": "^1.9.21",
    "@types/pdfmake": "^0.3.2",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^27.1.0",
    "orval": "^7.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "tar": ">=7.5.3",
    "undici": ">=7.29.0",
    "vite": "^7.3.4",
    "ws": ">=8.20.2",
    "piscina": ">=5.1.5",
    "sigstore": ">=4.1.1",
    "cross-spawn": ">=7.0.6",
    "picomatch": ">=4.0.2"
  }
}
